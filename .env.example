# 复制为 .env 后填入真实值。.env 已在 .gitignore 里，不会被提交。
#
#   Copy-Item .env.example .env      # PowerShell
#   cp .env.example .env             # bash
#
# 下面标了「必需」的缺一个服务就起不来（core/config.py 读它们时不会报错，
# 只会拿到 None，然后在第一次真正用到时才炸）。

# ---------- LLM ----------
# DeepSeek：问答图的默认模型、视觉模型（文档图片识别）都用它
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# OpenRouter：备用问答模型
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------- 数据库 ----------
# 必需。注意必须是 postgresql+asyncpg:// 这个驱动形式，
# db/__init__.py 用 create_async_engine 建连接池。
POSTGRESQL_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/your_db

# ---------- Milvus ----------
# 必需。Milvus standalone 默认 HTTP 端口 19530。
MILVUS_URI=http://127.0.0.1:19530
MILVUS_DB=default
MILVUS_COLLECTION=Documents

# ---------- 向量化 ----------
# 必需。走 OpenRouter 的 embedding 端点。
EMBEDDING_MODEL=openai/text-embedding-3-large

# ---------- 重排模型 ----------
# 可选。本地权重目录，或 HuggingFace 上的模型 id（不填则用默认值，首次会去下载）。
# 本机把权重量放在哪个目录就写哪个目录。
RERANKER_MODEL_PATH=

# ---------- 联网搜索 ----------
# 可选。当前问答图尚未接入 Web 搜索工具，留着备用。
TAVILY_API_KEY=

# ---------- LangSmith 追踪 ----------
# 可选。三个都由 langsmith 库自己读取，core/config.py 不解析。
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=

# ---------- 运行参数 ----------
# 下面这些都有合理默认值，不填也能跑；列在这里是因为调优时经常要改。

# 文档识图的并发上限（进程内信号量）
VISION_CONCURRENCY=6

# ingest worker：并行度只来自进程数，调大的真正上限是出网 API 并发，不是内存
INGEST_WORKERS=2
# 领到任务后多久算过期。解析大文件可能远超这个时长，worker 会在到期前续租
INGEST_LEASE_MINUTES=10
# 续租间隔，必须明显小于租约时长
INGEST_HEARTBEAT_SECONDS=120
# 单个文件最多被领几次，超过判死
INGEST_MAX_ATTEMPTS=3
# 队列空时的轮询间隔
INGEST_POLL_SECONDS=5

# 启动 API 时是否自动拉起 ingest worker 监督器 / MCP server。置 0 关闭。
# 用 uvicorn --reload 开发时可以关掉：每次热重载都会重新拉起 worker
# （每个常驻 1.5–3GB 的 Docling 模型）。
AUTO_START_WORKERS=1
AUTO_START_MCP=1

# 日志级别 DEBUG / INFO / WARNING / ERROR。默认 INFO。
# 调成 DEBUG 能看到检索耗时、逐篇 rerank 打分这类过程细节。
LOG_LEVEL=INFO
