# docker compose 环境变量模板（被 docker-compose.yml 的 env_file 引用）。
#
# 用之前复制成本地真值文件，再把占位符换成真值：
#     cp .env.docker.example .env.docker
#
# 版本库只提交这个模板，不提交 .env.docker——真 key 只留在你本机那一份（.env.docker
# 已被 .gitignore 忽略）。
#
# 为什么不直接用仓库根目录那份 .env：那是本机开发用的，里面 POSTGRESQL_URL 和
# MILVUS_URI 都指向 127.0.0.1（在容器里指的是容器自己），而 RERANKER_MODEL_PATH
# 是个 Windows 绝对路径 D:\AIModels\...（Linux 容器里根本不存在）。这个模板放的是
# 容器视角的值。
#
# 用 `docker compose`，别用 `docker run --env-file` —— 后者不解析引号，会引号连着
# 值一起传给程序。compose 的 env_file 解析正常，所以这里也刻意都不加引号，两边安全。
#
# ⚠️ 一条硬规则：**不要写 `VAR=` 这种空值行**。
# core/config.py 里那些可选配置全部是 `os.getenv("X", 默认值)` 的形式，而 os.getenv
# 只在「变量不存在」时才给默认值；变量存在但为空串，拿到的是空串。所以写成
# `AUTO_START_WORKERS=` 会把自动启动判成 False（`"" == "1"` 为假），容器起来了却
# 一个 worker 都不跑，而且不报错。不需要改的配置项就整行删掉，别留空。

# ---------- LLM ----------
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------- 数据库 ----------
# 两个都指向宿主机上已经在跑的服务。compose 里已经加了
# extra_hosts: host.docker.internal:host-gateway，这个域名在容器内解析到宿主机网关。
#
# !!! 用户名和密码必须是真实值，并且密码里的特殊字符要做 URL 编码
#     （@ : / ? # 在 URL 里有别的含义，不编码会让连接串解析错位）。
#     最省事的做法是把仓库根目录 .env 里的这一行整行复制过来，
#     只把 127.0.0.1 替换成 host.docker.internal。
POSTGRESQL_URL=postgresql+asyncpg://user:password@host.docker.internal:5432/your_db

MILVUS_URI=http://host.docker.internal:19530
MILVUS_DB=EKBQAS
MILVUS_COLLECTION=Documents

# ---------- 向量化 ----------
# 走 OpenRouter 的 embedding 端点，和知识库里的向量维度（3072）对应，别改。
EMBEDDING_MODEL=openai/text-embedding-3-large

# 注意这里**故意没有 RERANKER_MODEL_PATH**。这个变量在 Dockerfile 里已经用 ENV 写死成
# 容器内的本地路径 /app/models/bge-reranker-v2-m3 —— 构建镜像时把本地下载的模型 COPY
# 了进去，运行时直接读本地权重，不会再联网下。这里别再写：写 `RERANKER_MODEL_PATH=`
# （空值）会让 FlagReranker 拿到空字符串当模型路径直接报错；写成本机那个
# D:\AIModels\... 路径同样不行，容器里没有那个目录。

# ---------- 运行参数 ----------
# 1，而不是默认的 2。瓶颈是**内存**：Docker Desktop 给 WSL2 那台虚拟机默认只分物理内存
# 的一半（这台机器 15.7GB → 7.6GB），而每个 worker 常驻 1.5–3GB。开 2 个加上 API 进程
# 就可能顶到 VM 上限，而 VM 级别的 OOM 不只影响这个容器。
#
# 想调大得改**仓库外**的 `C:\Users\<你>\.wslconfig`（Docker Desktop 用 WSL2 后端时没有
# 内存滑块，那是唯一的开关），再同步调 compose 里的上限。注意 WSL2 不会主动把不用的内存
# 还给 Windows，调大之后宿主机可用内存会明显变少。
#
# 显存不是瓶颈：实测 reranker 占 1.1GB、每个 worker 的 Docling 占 0.4–0.7GB，
# 8GB 的卡开 2 个 worker 也才 2.5GB 左右。真正吃紧的是上面那个内存。
INGEST_WORKERS=1

AUTO_START_WORKERS=1
AUTO_START_MCP=1

LOG_LEVEL=INFO

# ---------- LangSmith 追踪（可选） ----------
LANGSMITH_TRACING=false
